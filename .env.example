# Public URL the browser uses to reach the app (used for OAuth callbacks
# and the desktop sign-in link <PUBLIC_URL>/device). Browser WebSocket
# connections are only accepted from this origin, so it must match what
# users type in the address bar (scheme, host and port).
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Data paths — uncomment and set these when using Docker with bind-mounts.
# The docker-compose.yml sets these automatically via named volumes.
# DB_PATH=/data/cbld.sqlite
# PARTS_DIR=/parts
# BACKUPS_DIR=/backups

# Cookie security — set to true behind TLS in production.
COOKIE_SECURE=false

# Reverse proxy — set when the app sits behind nginx / Traefik / a load
# balancer so client IPs (rate limiting, logs) come from X-Forwarded-For.
# false (default) = don't trust forwarded headers; true = trust any proxy;
# or a comma-separated list of proxy
# IPs/CIDRs (e.g. 10.0.0.0/8,127.0.0.1). Leave false when exposed directly:
# otherwise clients can spoof their IP.
TRUST_PROXY=false

# OAuth providers — leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generic OIDC (Microsoft Entra, Auth0, Keycloak, etc.)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Email/password — off by default. Signups require clicking an emailed
# verification link before they can log in (see SMTP below) — without
# SMTP configured, the link is only written to the server log, so set
# SMTP up before enabling this in anything but local dev.
ENABLE_PASSWORD_AUTH=false

# The demo account ("Try the demo" on the sign-in page) is switched on in
# Admin › Settings › Demo account. It has no env var.

# Bootstrap admin — created on first start if absent.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP — invites AND signup email-verification links are emailed if
# these are set; otherwise invites fall back to copy-paste links, and
# verification links are only written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Desktop sign-in needs no settings: the desktop app signs in through
# <PUBLIC_URL>/device (device-code flow) and gets a revocable token (see
# README "Desktop sign-in"). Optionally override the version reported by
# GET /api/version (defaults to the server package version):
# APP_VERSION=

# Background workers — daily tick. Each can be disabled individually.
BACKUPS_ENABLED=true
# Where the daily VACUUM INTO + gzip snapshots land. Override for local
# dev (default /backups exists in Docker; on the host pick a writable path).
BACKUPS_DIR=./data/backups
DAILY_COMPACTION_ENABLED=true
