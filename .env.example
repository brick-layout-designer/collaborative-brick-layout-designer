# Public URL the browser uses to reach the app (used for OAuth callbacks).
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Data paths — uncomment and set these when using Docker with bind-mounts.
# The docker-compose.yml sets these automatically via named volumes.
# DB_PATH=/data/cbld.sqlite
# PARTS_DIR=/parts
# BACKUPS_DIR=/backups

# Cookie security — set to true behind TLS in production.
COOKIE_SECURE=false

# OAuth providers — leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generic OIDC (Microsoft Entra, Auth0, Keycloak, etc.)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Email/password — off by default.
ENABLE_PASSWORD_AUTH=false

# Demo mode — registrations create demo accounts (see PLAN.md §3.4).
DEMO_MODE=false
DEMO_LAYOUT_TTL_DAYS=30

# Bootstrap admin — created on first start if absent.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP — invites are emailed if these are set; otherwise copy-paste links only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Background workers — daily tick. Each can be disabled individually.
BACKUPS_ENABLED=true
# Where the daily VACUUM INTO + gzip snapshots land. Override for local
# dev (default /backups exists in Docker; on the host pick a writable path).
BACKUPS_DIR=./data/backups
DEMO_TTL_SWEEP_ENABLED=true
DAILY_COMPACTION_ENABLED=true
