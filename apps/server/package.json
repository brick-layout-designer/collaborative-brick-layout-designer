{
  "name": "@cld/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@cld/bbm": "workspace:*",
    "@cld/model": "workspace:*",
    "@cld/parts-catalog": "workspace:*",
    "@cld/ydoc": "workspace:*",
    "@fastify/cookie": "9.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "7.0.4",
    "@fastify/websocket": "10.0.1",
    "@node-rs/argon2": "1.8.3",
    "arctic": "2.2.2",
    "better-sqlite3": "12.4.1",
    "drizzle-orm": "0.33.0",
    "fastify": "4.28.1",
    "lib0": "0.2.97",
    "nodemailer": "6.9.14",
    "openid-client": "5.6.5",
    "y-protocols": "1.0.6",
    "yjs": "13.6.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.5.4",
    "@types/nodemailer": "6.4.16",
    "drizzle-kit": "0.24.2",
    "tsx": "4.19.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
