{
  "name": "@cld/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "docs:env": "tsx scripts/gen-env-docs.ts"
  },
  "dependencies": {
    "@cld/bbm": "workspace:*",
    "@cld/model": "workspace:*",
    "@cld/parts-catalog": "workspace:*",
    "@cld/ydoc": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@node-rs/argon2": "2.2.2",
    "arctic": "3.7.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "lib0": "0.2.119",
    "nodemailer": "10.1.1",
    "openid-client": "6.8.8",
    "sharp": "0.35.5",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "ws": "^8.22.0"
  }
}
