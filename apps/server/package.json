{
  "name": "@cld/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@cld/bbm": "workspace:*",
    "@cld/model": "workspace:*",
    "@cld/parts-catalog": "workspace:*",
    "@cld/ydoc": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.2.0",
    "@node-rs/argon2": "1.8.3",
    "arctic": "2.2.2",
    "better-sqlite3": "12.4.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "lib0": "0.2.117",
    "nodemailer": "9.0.1",
    "openid-client": "5.6.5",
    "y-protocols": "1.0.7",
    "yjs": "13.6.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.2.0",
    "@types/nodemailer": "6.4.16",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "ws": "^8.20.0"
  }
}
