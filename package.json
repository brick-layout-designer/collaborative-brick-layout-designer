{
  "name": "cbld-web",
  "version": "0.0.0",
  "private": true,
  "description": "Collaborative Brick Layout Designer",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "audit": "pnpm audit --prod",
    "scan:secrets": "gitleaks detect --no-banner --redact -v --config .gitleaks.toml",
    "scan:deps": "npx -y -p osv-scanner@latest osv-scanner scan --recursive --skip-git ./",
    "prepare": "lefthook install",
    "e2e": "pnpm --filter @cld/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lefthook": "2.1.16",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
