{
  "name": "@cld/parts-catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cld/bbm": "workspace:*",
    "@cld/model": "workspace:*",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
